{
  "name": "l4d2-versus-addon-manager",
  "version": "0.1.0",
  "description": "Gestor de addons de la Steam Workshop para el modo Versus de Left 4 Dead 2 (Electron + TypeScript).",
  "private": true,
  "author": "L4D2 Versus Addon Manager contributors",
  "license": "MIT",
  "main": "dist/src/main/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.json -w",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "dev": "concurrently -k -n vite,preload,electron \"vite\" \"npm:dev:preload\" \"wait-on tcp:5173 dist/src/preload/preload.js && tsc -p tsconfig.json && vite build --config vite.preload.config.ts && electron .\"",
    "electron:pack": "electron-builder --dir",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "fast-check": "4.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wait-on": "9.1.0"
  }
}
