# ---- Dependencias ----
node_modules/

# ---- Salida de build / empaquetado (Electron + electron-builder) ----
dist/
build/
out/
release/
*.tsbuildinfo

# ---- VPK: nunca versionar archivos VPK ----
# Regla general: excluye cualquier .vpk en cualquier carpeta del repo por
# defecto. Es la que realmente protege contra commitear VPK (fusionados,
# fixtures binarios, copias de addons, etc.). Las reglas puntuales de mas
# abajo quedan como redundancia documentativa.
*.vpk

# ---- Datos locales generados por LocalStore en tiempo de ejecucion ----
# Contienen datos reales de CADA instalacion (ruta de Steam del usuario,
# su Active_Set, presets, estado de sesion pendiente). NO pertenecen al repo.
*.sqlite
*.sqlite3
*.db
local-store.json
localstore.json
app-data/
userdata/
# Acotados a la carpeta de datos de usuario para NO ignorar por accidente
# archivos de codigo/build que puedan llamarse igual en la raiz o en src.
userdata/manifest.json
userdata/paths.json

# ---- Carpetas de trabajo temporal del Manager (extraccion / fusion) ----
# Si se prueba el flujo localmente dentro del repo, el Manager crea carpetas
# temporales de extraccion y fusion. No deben versionarse.
work/
tmp/
temp/
extract/
pak01_dir/
pak01_dir.vpk
*.vpk.backup*
test_vpk_extraction/
test_collision/

# ---- Fixtures de VPK generados localmente ----
# Los VPK de prueba se GENERAN sinteticamente en cada maquina (ver
# test/fixtures/README.md); no se versionan binarios .vpk.
test/fixtures/**/*.vpk
test/fixtures/vpk/generated/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Entorno / secretos ----
.env
.env.*
!.env.example

# ---- Artefactos de sistema operativo ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Editores / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ---- Cobertura de tests ----
coverage/
.nyc_output/

# ---- Metadata interna del tracker de tareas de Kiro ----
# tasks.meta.json es estado de tracking/sincronizacion del orquestador de
# tareas de Kiro, NO codigo del proyecto. Puede desincronizar checkboxes de
# tasks.md entre ramas (visto en la sesion de la rama addon-scanner). No
# pertenece al repo.
**/tasks.meta.json

# Salida regenerable del harness de medicion de rendimiento (no versionar).
perf-resultados.txt

# ---- Handoff de diseño del rediseño (mockups .dc.html, screenshots, README) ----
# Material de referencia del rediseño (Claude Design), no codigo del proyecto.
# Se consulta localmente paso a paso, no se versiona.
design-handoff/

# ---- Cache del hook de revision de diseño (impeccable) ----
# .impeccable/config.json (las excepciones ignore-value/ignore-rule/ignore-file)
# SI se versiona; el cache de resultados por archivo es regenerable, no.
.impeccable/hook.cache.json
